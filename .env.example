OPENSYNDROME_PROVIDER=ollama
OPENSYNDROME_MODEL=mistral
# optional: directory with your own definitions, read alongside the community ones
# OPENSYNDROME_DEFINITIONS_DIR=./my-definitions
# optional: ignore the community definitions and use OPENSYNDROME_DEFINITIONS_DIR only
# OPENSYNDROME_LOCAL_DEFINITIONS_ONLY=1
# mandatory only if using Ollama
OLLAMA_BASE_URL=http://localhost:11434
# optional: add the API KEY of your desired provider in your .env file
ANTHROPIC_API_KEY=sk-ant-...
MISTRAL_API_KEY=...
DEEPSEEK_API_KEY=...
GEMINI_API_KEY=...
OPENAI_API_KEY=sk-...
